PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/saavana
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Resend — transactional email (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx
# Verified fallback From (used until EMAIL_FROM_* mailboxes are verified on your domain)
RESEND_FROM_EMAIL=NileCart <onboarding@resend.dev>

# Email domain + mailbox From addresses (Seller lifecycle B1–B9)
EMAIL_DOMAIN=nilescart.com
EMAIL_FROM_ACCOUNTS=NileCart <accounts@nilescart.com>
EMAIL_FROM_SELLER=NileCart Sellers <seller@nilescart.com>
EMAIL_FROM_ADMIN=NileCart Admin <admin@nilescart.com>
EMAIL_FROM_SUPPORT=NileCart Support <support@nilescart.com>
EMAIL_FROM_SECURITY=NileCart Security <security@nilescart.com>
EMAIL_FROM_LEGAL=NileCart Legal <legal@nilescart.com>
EMAIL_FROM_NOREPLY=NileCart <no-reply@nilescart.com>
EMAIL_FROM_INVENTORY=NileCart Inventory <inventory@nilescart.com>
# Comma-separated ops inboxes for new seller application alerts (B2)
EMAIL_ADMIN_NOTIFY=admin@nilescart.com,support@nilescart.com

# Inventory alerts (C4 low stock / C5 out of stock)
LOW_STOCK_THRESHOLD=5

# Seller / admin dashboard origin (CTA links in lifecycle emails)
DASHBOARD_URL=http://localhost:5173

# Legacy SMTP (unused by runtime — Resend is the active provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="NileCart <your-email@gmail.com>"

# One-time admin setup (run: npm run seed:admin)
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=your_secure_password
# ADMIN_NAME=Platform Admin

# AWS S3 — file uploads (IAM user must allow s3:PutObject on bucket objects)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
# Optional — CloudFront or custom public URL (defaults to S3 virtual-hosted URL)
# AWS_S3_PUBLIC_URL=https://cdn.yourdomain.com
#
# Required IAM policy (attach to the IAM user above):
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": ["s3:PutObject", "s3:DeleteObject"],
#       "Resource": "arn:aws:s3:::your-bucket-name/*"
#     }
#   ]
# }
#
# S3 bucket CORS (for browser PUT uploads):
# AllowedMethods: PUT, GET, HEAD | AllowedOrigins: your dashboard URL | AllowedHeaders: *

# Storefront (Next.js) — used for Flutterwave payment redirect URLs
STOREFRONT_URL=http://localhost:3000
# PAYMENT_CURRENCY=UGX
# PAYMENT_CURRENCY_SYMBOL=UGX
# FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoneyuganda,banktransfer

# Flutterwave v3 — hosted checkout, verify, webhooks
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=your_random_webhook_secret_hash
# FLUTTERWAVE_USE_SANDBOX=true

# Flutterwave v4 OAuth (optional — customers, payment methods, charges API)
# FLUTTERWAVE_CLIENT_ID=
# FLUTTERWAVE_CLIENT_SECRET=
